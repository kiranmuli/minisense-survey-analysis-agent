# ============================================================================
# Copy this file to ".env":   copy .env.example .env   (Windows)
# We run everything LOCALLY with Ollama — no API key, no cost.
# ============================================================================

# --- LLM backend ---
# "ollama" = local models via Ollama's OpenAI-compatible API (default).
# "openai" = real OpenAI cloud (needs OPENAI_API_KEY).
LLM_BACKEND=ollama

# Ollama's OpenAI-compatible endpoint (default when Ollama is running locally).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Chat model the agents use. Options you have installed:
#   qwen3:8b        -> stronger reasoning + tool calling (recommended)
#   llama3.2:latest -> smaller & faster fallback
OLLAMA_MODEL=qwen3:8b

# --- Embeddings (RAG) ---
# "ollama" = use nomic-embed-text via Ollama (you already have it).
# "local"  = sentence-transformers all-MiniLM-L6-v2.
# "openai" = text-embedding-3-small (cloud).
EMBEDDING_BACKEND=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Only needed if you switch LLM_BACKEND / EMBEDDING_BACKEND to "openai" ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
