# ============================================================================
# Copy this file to ".env" and fill in your real key.
#   copy .env.example .env      (Windows)
# The real .env is gitignored, so your key never gets committed.
# ============================================================================

# Your OpenAI API key (starts with "sk-...")
OPENAI_API_KEY=your-key-here

# Which chat model the agents use for reasoning / summarizing.
OPENAI_MODEL=gpt-4o-mini

# Which embedding backend for RAG: "local" (sentence-transformers, free)
# or "openai" (text-embedding-3-small, uses your API quota).
EMBEDDING_BACKEND=local
