# ============================================================================
# Copy this file to ".env":   copy .env.example .env   (Windows)
# We run everything LOCALLY with Ollama — no API key, no cost.
# ============================================================================

# --- LLM backend ---
# "ollama" = local models via Ollama's OpenAI-compatible API (default).
# "openai" = real OpenAI cloud (needs OPENAI_API_KEY).
LLM_BACKEND=ollama

# Ollama's OpenAI-compatible endpoint (default when Ollama is running locally).
OLLAMA_BASE_URL=http://localhost:11434/v1

# Chat model the agents use:
#   llama3.2:latest -> fast, usable on CPU (default; ~30-90s/question)
#   qwen3:8b        -> higher quality but MUCH slower on CPU (~10-18 min/question)
# On a GPU, qwen3:8b is the better choice.
OLLAMA_MODEL=llama3.2:latest

# --- Embeddings (RAG) ---
# "ollama" = use nomic-embed-text via Ollama (you already have it).
# "local"  = sentence-transformers all-MiniLM-L6-v2.
# "openai" = text-embedding-3-small (cloud).
EMBEDDING_BACKEND=ollama
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Logging ---
# INFO  = normal (one concise line per pipeline step).
# DEBUG = full teaching trace: every prompt sent to the model, the tool calls it
#         chooses, the exact numbers computed, retrieved FAQ chunks, and the
#         evidence handed to the SummaryAgent.
LOG_LEVEL=INFO

# --- Only needed if you switch LLM_BACKEND / EMBEDDING_BACKEND to "openai" ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
